# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
secrets.json

# --- Testing, Coverage & Quality ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.tox/
.nox/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- IDEs & Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.fuse_hidden*
.directory

# --- Databases, Logs & Runtime Telemetry ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.log
logs/

# --- ML Training, Experiment Tracking & Caching ---
wandb/
mlruns/
runs/
lightning_logs/
.neptune/
*.tfevents.*
.cache/
hf_cache/

# --- Intermediate Model Checkpoints ---
# Ignores step-by-step training checkpoints while keeping best_model if tracked
checkpoints/**/checkpoint-*
checkpoints/**/step-*
